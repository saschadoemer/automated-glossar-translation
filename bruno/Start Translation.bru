meta {
  name: Start Translation
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/start
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(/Users/sdo/Git/glossar-translation/local-data/glossar-master-data.csv)
  targetLanguage: es-ES
  fuzzy: false
  llmType: gemini
  waitTime: 3
}
