meta {
  name: Start Translation
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/start
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(/Users/sdo/Git/glossar-translation/local-data/glossar-master-data.csv)
  targetLanguage: no-NO
  fuzzy: true
  waitTime: 1
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("jobId", res.body.jobId);
  }
}
